# demo-agent settings. Copy to .env on the box (never commit it). Secret values are left empty here.

# network and asset: base-sepolia + eth for rehearsal; base + usdc for the real pot
DEMO_NETWORK=base-sepolia
DEMO_ASSET=eth
# DEMO_RPC_URL=            # own node; defaults to the network's public one
# DEMO_SAYSO_API=          # defaults to sayso's server for the network

# model access, where api.anthropic.com is not served directly (only the model's traffic uses these)
# DEMO_LLM_MODEL=claude-haiku-5-5
# a gateway or reverse proxy that speaks the Anthropic API; https only, no credentials in the URL
DEMO_LLM_BASE_URL=
# a forward http(s) proxy, may be http://user:pass@host:port; a secret like the keys below.
# With an Outline key: http://outline:1080 and the compose profile "outline" (README, Model access)
DEMO_LLM_PROXY=

# the vendor book: Name=0xAddress=usual amount;… Every address must be a wallet we control.
DEMO_VENDORS=Northwind Hosting=0xREPLACE_WITH_OUR_WALLET=0.0002;Lantern Design=0xREPLACE_WITH_OUR_WALLET=0.0003

# secrets (the only secret names the box accepts; see src/isolation.ts)
ANTHROPIC_API_KEY=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
DEMO_SAYSO_API_KEY=
DEMO_ADMIN_TOKEN=

# server
DEMO_PORT=8787
DEMO_HOST=127.0.0.1
# DEMO_TRUST_LOCAL_HEADER=cf-connecting-ip   # only behind a proxy on this machine that sets it
# DEMO_TRUSTED_PROXY=172.30.0.1              # proxy addresses besides loopback whose header is believed; exact IPs, comma-separated; required when DEMO_HOST is not loopback
DEMO_DATA_DIR=data
DEMO_CDP_ACCOUNT=sayso-demo-agent
DEMO_AGENT_NAME=Penny
# the public repo for the page's "Read the code" link; https only, no credentials. Empty hides the link.
DEMO_SOURCE_URL=

# money safety: ceiling on the fee per gas (also tightens saysoio's fee bounds), and the signed per-payment cap (an allow above it pauses the game).
# The cap is in DEMO_ASSET's unit (ETH or USDC), is required on base, and setup signs the same value.
DEMO_MAX_FEE_GWEI=1
DEMO_MAX_PER_PAYMENT=0.0005
# the daily and weekly caps setup signs; the box shows them on the page as the published rules (GET /api/rules), so set
# the same values here as on the owner's Mac
# DEMO_DAILY_CAP=0.005
# DEMO_WEEKLY_CAP=0.015    # default: three times the daily cap

# pace and limits
DEMO_TICK_MS=3000
DEMO_VENDOR_INVOICE_EVERY_MS=1200000
DEMO_LIMIT_HANDLE_HOUR=10
DEMO_LIMIT_IP_HOUR=30
DEMO_LIMIT_IP_DAY=120
DEMO_LIMIT_PER_MINUTE=20
DEMO_MODEL_CALLS_DAY=3000

# model spend: USD per million tokens (claude-haiku-5-5 by default; cache writes cost 1.25x and reads 0.1x the input
# price), and a daily budget per UTC day. Reaching it pauses the game until the next UTC day, when that pause lifts by
# itself. Empty: no budget. Operator view: GET /api/admin/spend (README, Going live).
# DEMO_LLM_PRICE_IN_PER_MTOK=0.10
# DEMO_LLM_PRICE_OUT_PER_MTOK=0.50
DEMO_LLM_BUDGET_USD=
DEMO_QUEUE_MAX=50

# setup only (on the owner's Mac, never on the box)
# OWNER_PRIVATE_KEY=
# DEMO_INVITE=             # mainnet registration is invite-only
