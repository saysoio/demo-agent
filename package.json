{
  "name": "demo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sayso's public demo: an invoice-paying agent with a real prize pot, guarded by the saysoio SDK in enforce mode. Players try to trick it through /game/.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "DEMO_FAKE=1 DEMO_DEV=1 node --watch src/main.ts",
    "setup": "node --env-file-if-exists=.env.setup src/setup.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@coinbase/cdp-sdk": "1.60.0",
    "saysoio": "0.6.3",
    "undici": "^7.21.0",
    "viem": "2.57.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
